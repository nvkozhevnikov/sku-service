# Public template only. Copy to ignored .env.release; secrets are separate files.
CONTROL_PLANE_ALLOWED_HOSTS=127.0.0.1,localhost,panel.example.org
HTTPS_ENABLED=YES
CONTROL_PLANE_INSECURE_HTTP=NO
STERBRUST_DEPLOYMENT_CONTRACT=/run/config/deployment-contract.json
STERBRUST_DEPLOYMENT_CONTRACT_SHA256=REPLACE_WITH_VERIFIED_FILE_SHA256
STERBRUST_DEPLOYMENT_CONFIRMED=YES
STERBRUST_SOURCE_RUNTIME_ENABLED=YES
# Set to YES after building from a clean checkout with RELEASE_GIT_SHA.
STERBRUST_MANUAL_COLLECTION_ENABLED=NO
# Build argument, never a credential. Set it to the full SHA of the checkout.
RELEASE_GIT_SHA=
SCHEDULER_ENABLED=NO
STERBRUST_WRITE_ENABLE=NO
ESOL_WRITE_ENABLE=NO
# Native same-session mount. Enabling requires the separately approved migration.
CONTENT_STUDIO_ENABLED=NO
# compose.release.yml keeps real AI/VK/site calls disabled independently.
