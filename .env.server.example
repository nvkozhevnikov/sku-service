# Copy to .env.server; never commit the filled file.
POSTGRES_ADMIN_USER=universal_supplier_server_admin
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_VALUE
DB_NAME=universal_supplier_server
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable
DB_USER=universal_supplier_server_app
DB_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_VALUE
SESSION_SIGNING_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CONTROL_PLANE_ALLOWED_HOSTS=127.0.0.1,localhost
WEB_HOST_PORT=58097
COMMERCIAL_SERVER_WRITE_ENABLE=NO
COMMERCIAL_SERVER_WRITE_CONFIRM=NO
# Fill only after controlled init: SELECT system_identifier FROM pg_control_system();
DB_SYSTEM_IDENTIFIER=0
SCHEDULER_ENABLED=NO
STERBRUST_WRITE_ENABLE=NO
ESOL_WRITE_ENABLE=NO
FINAL_RC_MANIFEST_SHA256=REPLACE_WITH_SHA256_MANIFEST_FILE_DIGEST
SERVER_PGDATA_VOLUME=universal_supplier_server_pgdata
SERVER_ARTIFACTS_VOLUME=universal_supplier_server_artifacts
