FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY stage3d_migration_baseline_sha256.json stage6c1_migration_baseline_sha256.json stage6e_migration_baseline_sha256.json ./
COPY universal_supplier ./universal_supplier
COPY sterbrust_matching ./sterbrust_matching
COPY scripts ./scripts
COPY migrations ./migrations
COPY config ./config
RUN mkdir -p /app/server-artifacts /app/server-manifests
