FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 CONTROL_PLANE_SKIP_DEFAULT_APP=YES CONTROL_PLANE_INSECURE_HTTP=YES
WORKDIR /app
COPY requirements-qa.lock /tmp/requirements-qa.lock
RUN pip install --no-cache-dir -r /tmp/requirements-qa.lock
COPY . /app
CMD ["python", "-m", "pytest", "-p", "no:cacheprovider", "--basetemp=/tmp/release-pytest", "-q"]
