FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY stage3d_migration_baseline_sha256.json stage6c1_migration_baseline_sha256.json stage6e_migration_baseline_sha256.json ./
COPY universal_supplier ./universal_supplier
COPY sterbrust_matching ./sterbrust_matching
COPY scripts ./scripts
COPY migrations ./migrations
COPY config ./config
# Non-root runtime. Fresh named volumes inherit this ownership; a volume created by an older root image
# needs a one-time `chown -R 10001:10001 /app/server-artifacts` (run the container with --user root).
RUN useradd --system --uid 10001 --home-dir /app --shell /usr/sbin/nologin app \
    && mkdir -p /app/server-artifacts /app/server-manifests \
    && chown -R app:app /app/server-artifacts
USER app
